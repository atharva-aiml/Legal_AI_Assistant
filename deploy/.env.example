# Copy to deploy/.env on the VM and fill in. deploy/.env is gitignored.

# Public hostname. Zero-signup option: your VM's public IP with dashes + .sslip.io,
# e.g. 140.238.1.23 -> 140-238-1-23.sslip.io
DOMAIN=

# Letters/digits only (it's embedded in a connection URL). Generate with:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Gemini API key (free tier) — https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional override of the model fallback list.
# LLM_CHAT_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
