# Copy this file to .env.local and fill in real values.

# Backend API (System Architecture §4) — the Python/FastAPI backend in
# /backend-python. The "JAVA_" names are historical (the API used to be a
# Spring Boot service on the same port); they're kept so no frontend code
# had to change. Server-side and client-side variants because Server
# Components need JAVA_API_URL (no NEXT_PUBLIC_ prefix — never sent to the
# browser) while client components need NEXT_PUBLIC_JAVA_API_URL (inlined
# at build time).
JAVA_API_URL=http://localhost:8080
NEXT_PUBLIC_JAVA_API_URL=http://localhost:8080
