# Copy this file to .env.local and fill in real values.

# Java backend (System Architecture §4). Server-side and client-side
# variants because Server Components need JAVA_API_URL (no NEXT_PUBLIC_
# prefix — never sent to the browser) while client components need
# NEXT_PUBLIC_JAVA_API_URL (inlined at build time).
JAVA_API_URL=http://localhost:8080
NEXT_PUBLIC_JAVA_API_URL=http://localhost:8080
